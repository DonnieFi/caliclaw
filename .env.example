# OpenAI-compatible model used by the workbench chat.
CALICLAW_API_KEY=
CALICLAW_BASE_URL=https://api.reflection.ai/openai/v1
CALICLAW_MODEL=

# Optional second provider. The model dropdown keeps the same conversation.
COMPARISON_API_KEY=
COMPARISON_BASE_URL=
COMPARISON_PROVIDER=comparison
COMPARISON_MODEL=

# App storage. Paths stay on this machine.
CALICLAW_DB=caliclaw.db
CALICLAW_ARTIFACT_ROOT=/tmp/caliclaw-artifacts

# OctoPrint. Required only for live status, camera, and explicit job controls.
OCTOPRINT_BASE_URL=http://127.0.0.1:5000
OCTOPRINT_API_KEY=
