# OpenAI-compatible model used by the workbench chat.
CALICLAW_API_KEY=
CALICLAW_BASE_URL=https://api.reflection.ai/openai/v1
CALICLAW_MODEL=

# Optional second provider. The model dropdown keeps the same conversation.
COMPARISON_API_KEY=
COMPARISON_BASE_URL=
COMPARISON_PROVIDER=comparison
COMPARISON_MODEL=

# App storage. Paths stay on this machine.
CALICLAW_DB=caliclaw.db
CALICLAW_ARTIFACT_ROOT=/tmp/caliclaw-artifacts

# OctoPrint. Required only for live status, camera, and explicit job controls.
OCTOPRINT_BASE_URL=http://127.0.0.1:5000
OCTOPRINT_API_KEY=

# Optional local copy of collected printer logs. Read-only; never a fixture default.
CALICLAW_PRINTER_LOG=

# User-confirmed PrusaSlicer profile. Live upload/start requires an exact hash match.
# Leave empty to use the clearly labeled 0.4 mm fixture for preparation only.
CALICLAW_PROFILE_PATH=
CALICLAW_PROFILE_SHA256=

# Printer setup in the UI stores reviewed connections privately here (mode 0600).
CALICLAW_PRINTER_CONFIG=printers.local.json

# Optional explicit overlay for the environment-configured printer.
CALICLAW_OVERLAY_PATH=
CALICLAW_OVERLAY_SHA256=
# Snapshot is separately configured; no OctoPrint key is forwarded to the camera.
CALICLAW_SNAPSHOT_URL=

# Legacy path aliases remain supported; the SHA256 review fields above still apply.
# Prefer CALICLAW_PROFILE_PATH / CALICLAW_OVERLAY_PATH for new configurations.
CALICLAW_SLICER_PROFILE=
CALICLAW_SLICER_OVERLAY=
